    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.12",
    "typescript": "^5.3.3"
  },
